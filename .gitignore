# all encoded files can be easily encoded again
*.ebk 

# any obj outside ./assets dir is irrelevant 
*.obj
!assets/*.obj
!assets/**/*.obj

# ignore all new assets (don't want to ship gigabytes of assets in git)
assets/

# since I do not compile into build/ dir, I need to ignore all binaries
ebk/ebk
ebk-vis/ebk-vis
vibed-vis/vibed-vis

# logs
log*
